{
  "name": "@aether-cloud/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check",
    "dev:api": "pnpm --filter @aether-cloud/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:opentofu-integration": "AETHER_CLOUD_RUN_OPENTOFU_INTEGRATION=1 vitest run --config vitest.opentofu.config.ts",
    "test:mqtt-integration": "AETHER_CLOUD_RUN_MQTT_INTEGRATION=1 vitest run --config vitest.mqtt.config.ts",
    "test:cloudlink-dual": "tsx scripts/run-cloudlink-dual-harness.ts",
    "test:cloudlink-alpha-harness": "pnpm test:cloudlink-dual",
    "test:cloudlink-aws-iot": "AETHER_CLOUD_RUN_AWS_IOT_INTEGRATION=1 tsx scripts/run-cloudlink-aws-iot-harness.ts",
    "test:postgres-integration": "vitest run --config vitest.postgres.config.ts",
    "test:coverage": "node --test tests/*.test.mjs && vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.0.10",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "4.0.10"
  }
}
