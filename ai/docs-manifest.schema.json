{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvanL1/AetherCloud/main/ai/docs-manifest.schema.json",
  "title": "AetherCloud agent documentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "project", "documents"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/EvanL1/AetherCloud/main/ai/docs-manifest.schema.json"
    },
    "schema_version": {
      "const": 3
    },
    "project": {
      "const": "aether-cloud"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "canonical_url",
        "title",
        "description",
        "locale",
        "translation_of",
        "document_role",
        "agent_profiles",
        "intents",
        "implementation_status",
        "production_readiness",
        "context_sensitivity",
        "updated",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:ai|docs)/.+\\.md$"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locale": {
          "enum": ["en", "zh-CN"]
        },
        "translation_of": {
          "type": ["string", "null"]
        },
        "document_role": {
          "enum": [
            "agent-task",
            "operations",
            "safety",
            "recovery",
            "reference",
            "decision",
            "status"
          ]
        },
        "agent_profiles": {
          "type": "array",
          "items": {
            "enum": ["coding-agent", "operator-agent", "runtime-agent"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "intents": {
          "$ref": "#/$defs/stringList"
        },
        "implementation_status": {
          "enum": ["implemented", "partial", "planned", "deprecated"]
        },
        "production_readiness": {
          "enum": [
            "production-ready",
            "experimental",
            "not-production-ready",
            "not-applicable"
          ]
        },
        "context_sensitivity": {
          "enum": [
            "public",
            "internal",
            "redacted-only",
            "sensitive-never-load"
          ]
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "priority": {
          "enum": ["core", "optional"]
        },
        "capability_refs": {
          "$ref": "#/$defs/stringList"
        },
        "implemented_layers": {
          "$ref": "#/$defs/stringList"
        },
        "missing_layers": {
          "$ref": "#/$defs/stringList"
        },
        "preconditions": {
          "$ref": "#/$defs/stringList"
        },
        "recovery_route": {
          "type": "string",
          "pattern": "^docs/recovery/.+\\.md$"
        },
        "human_escalation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
