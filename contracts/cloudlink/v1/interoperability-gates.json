{
  "schema_version": 1,
  "contract": "aether.cloudlink",
  "contracts_release": "0.1.0-alpha.4",
  "status": "non-authoritative-aethercloud-readiness-overlay",
  "authoritative_gate_definition": "AetherContracts compatibility/cloudlink-v1alpha1-gates.json",
  "default_mode": "legacy",
  "physical_control": "forbidden",
  "gate_evidence": {
    "shared-broker-authentication": {
      "status": "proposal",
      "evidence": [
        "session-authentication.schema.json",
        "ADR-0015"
      ]
    },
    "signed-correlated-session-accepted": {
      "status": "blocked",
      "evidence": [
        "alpha.4 adds this gate; it depends on shared-broker-authentication, which is still a proposal",
        "the alpha.4 session-accepted response is unsigned and has no frozen signing projection",
        "AetherCloud has no Cloud key lifecycle, so it cannot bind an accepted challenge to its response"
      ]
    },
    "single-wire-contract": {
      "status": "implemented-alpha3",
      "evidence": [
        "aether-contracts.lock.json",
        "wire-profile.json"
      ]
    },
    "cross-language-fixtures": {
      "status": "implemented-alpha3",
      "evidence": [
        "fixture-manifest.json",
        "25 TypeScript fixture outcomes"
      ]
    },
    "real-broker-dual-harness": {
      "status": "implemented-alpha3",
      "evidence": [
        "pnpm test:cloudlink-alpha-harness",
        "evidence/cloudlink-alpha3-dual-harness.json"
      ]
    },
    "fault-injection": {
      "status": "implemented-alpha3",
      "evidence": [
        "interoperability-scenarios.json",
        "evidence/cloudlink-alpha3-dual-harness.json"
      ]
    },
    "signed-durable-ack": {
      "status": "blocked",
      "evidence": [
        "alpha.3 ACK is unsigned",
        "accepted telemetry has a PostgreSQL transactional inbox/cursor/receipt/ACK outbox and crash-boundary tests",
        "production session/credential/loss persistence and database/worker composition remain absent"
      ]
    },
    "legacy-cutover": {
      "status": "blocked",
      "evidence": [
        "legacy remains the explicit default"
      ]
    }
  }
}
